{
  "name": "magic-mapper-webos",
  "version": "1.1.0",
  "private": true,
  "description": "A TV-native Homebrew wrapper for Magic Mapper",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "nub run format:check && nub run lint && nub run typecheck && python3 -m unittest discover -s tests -v && python3 -m py_compile runtime/managed_mapper.py runtime/magic_mapper_runtime.py runtime/mapperctl.py vendor/magic_mapper.py",
    "dev": "vite --host 127.0.0.1",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -D correctness -D suspicious -D perf --import-plugin --jsx-a11y-plugin src scripts vite.config.ts",
    "package": "nub run build && node scripts/package.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8765",
    "test:e2e": "python3 tests/e2e_ui.py",
    "typecheck": "tsc --noEmit",
    "manifest": "node scripts/manifest.mjs",
    "sync-upstream": "node scripts/sync-upstream.mjs"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.0",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.28",
    "@tailwindcss/vite": "4.3.3",
    "@webos-tools/cli": "^3.2.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "nub@0.7.5"
}
